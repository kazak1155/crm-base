            <add name="php-7.0.13" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\Program Files (x86)\PHP\v7.0nts\php-cgi.exe" resourceType="Either" requireAccess="Script" />
            <add name="php-5.6.12_1" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\Program Files (x86)\PHP\v5.6nts\php-cgi.exe" resourceType="Either" requireAccess="Script" />
