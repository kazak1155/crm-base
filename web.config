<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<rewrite>
			<rules>
                <clear />
                <rule name="preventFShit" stopProcessing="true">
                    <match url=".*filestream.*" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="None" />
                </rule>
                <rule name="img" stopProcessing="true">
                    <match url="/img/" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="None" />
                </rule>
                <rule name="Convert to lower case" stopProcessing="false">
                    <match url="[A-Z]" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{URL}" pattern=".*css|js|scss" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{ToLower:{URL}}" />
                </rule>
                <rule name="plugins" stopProcessing="false">
                    <match url="^plugin$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
                    <action type="Rewrite" url="templates/main/plugins_tmpl" />
                </rule>
                <rule name="phpRewrite" stopProcessing="false">
                    <match url="^([^\.]+)$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{URL}" pattern="\/.*\/.*\/" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.php" />
                </rule>
                <rule name="Redirect .php extension" enabled="false" stopProcessing="false">
                    <match url="^(.*).php$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAny" trackAllCaptures="false">
                        <add input="{URL}" pattern="(.*).php$" ignoreCase="false" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>
                <rule name="hide .php extension" stopProcessing="false">
                    <match url="^(.*)$" ignoreCase="true" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:0}.php" />
                </rule>
			<!--
				<rule name="Redirect to tlc-online" stopProcessing="true">
					<match url=".*tinvest-group.*" ignoreCase="false" />
					<action type="Redirect" url="http://crmtest.tlc-online.ru{REQUEST_URI}" redirectType="Permanent" appendQueryString="false"/>
				</rule>
			-->
				<!-- REDIRECT TO HTTPS -->
			<!--
				<rule name="Redirect to HTTPS" stopProcessing="true">
					<match url="(.*)" negate="false" />
					<conditions logicalGrouping="MatchAll">
						<add input="{HTTPS}" pattern="^OFF$" />
					</conditions>
					<action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="SeeOther"/>
				</rule>
			-->
				<!-- PREVENT ALL LAME ACTIONS ON FILESTREAM -->
				
				
				<!-- PREVENT ALL LAME ACTIONS ON ROOT -->
				<!--
				<rule name="preventShit" stopProcessing="true">
					<match url=".*css|js|scss" ignoreCase="false" />
					<action type="None" />
				</rule>
				-->

				<!-- CONVERT URL TO LOVERCASE -->
				

                <!-- REMOVE FOLDER, REDIRECT, STOP PROCESSING -->
				<!--
                <rule name="RemoveFolder" stopProcessing="true">
                    <match url="^templates/(.*)$" />
                    <conditions logicalGrouping="MatchAny">
                    	<add input="{URL}" pattern=".*.css" negate="true" />
                    	<add input="{URL}" pattern=".*.scss" negate="true" />
                    	<add input="{URL}" pattern=".*.js" negate="true" />
                    </conditions>
                    <action type="Redirect" url="{R:1}" />
                </rule>
				 -->
                <!-- -->


					 <!--
                <rule name="RewriteToFile">
                    <match url="^(?!templates\/)(?!php.*\/)(.*)" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="templates/{R:1}" />
                </rule>
				 	-->

                <!-- REWRITE FILES WITHOUT DOT(.) AS PHP -->
  				

  				<!-- REDIRECT .PHP -->
				
    		</rules>
    	</rewrite>
    	<security>
			<requestFiltering allowDoubleEscaping="true">
				<hiddenSegments applyToWebDAV="true">
					<add segment="json" />
					<add segment="composer.json" />
				</hiddenSegments>
				<requestLimits maxAllowedContentLength="1073741824" maxQueryString="1073741824" maxUrl="1073741824" />
			</requestFiltering>
			<authorization>
				 <add accessType="Deny" users="?" />
			</authorization>
		</security>
        <staticContent>
				<remove fileExtension=".woff" /> <!-- In case IIS already has this mime type -->
				<mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
				<remove fileExtension=".woff2" /> <!-- In case IIS already has this mime type -->
				<mimeMap fileExtension=".woff2" mimeType="application/x-font-woff2" />
				<clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
			</staticContent>
			<httpProtocol>
				<customHeaders>
					<add name="Cache-Control" value="public" />
				</customHeaders>
			</httpProtocol>
			<caching enabled="true" enableKernelCache="true">
             <profiles>
 					<add extension=".png" policy="CacheUntilChange" />
 					<add extension=".jpg" policy="CacheUntilChange" kernelCachePolicy="DontCache" />
             </profiles>
         </caching>
        <tracing>
            <traceFailedRequests>
                <add path="*">
                    <traceAreas>
                        <add provider="WWW Server" areas="Rewrite" verbosity="Verbose" />
                    </traceAreas>
                    <failureDefinitions timeTaken="00:00:00" statusCodes="100-500" />
                </add>
            </traceFailedRequests>
        </tracing>
        <handlers>
            <clear />
            <add name="php-7.4.33" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" requireAccess="Script" />
            <add name="php-7.4.3" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\Program Files\PHP\v7.4\php-cgi.exe" resourceType="Either" requireAccess="Script" />
            <add name="php-7.3.15" path="*.php" verb="GET,HEAD,POST" modules="FastCgiModule" scriptProcessor="C:\Program Files\PHP\v7.3\php-cgi.exe" resourceType="Either" requireAccess="Script" />
